# Öffentliche Basis-URL (für SEO, Sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ynk.example

# Empfänger aller Formular-Anfragen  ->  [E-MAIL]
FORM_RECIPIENT=hello@ynk.example
FORM_SENDER="YNK Website <noreply@ynk.example>"

# SMTP-Versand. Ohne SMTP_HOST werden Formulare nur im Server-Log ausgegeben.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Signatur-Secret für Portal-Sessions (mind. 32 Zeichen, zufällig!)
SESSION_SECRET=change-me-to-a-long-random-string-please
